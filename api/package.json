{
  "name": "@snail-race/api",
  "private": true,
  "description": "SnailPay: pasarela de pagos simulada (Express + TypeScript)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "node build.js",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test:postman": "newman run postman/snailpay.postman_collection.json -e postman/snailpay.local.postman_environment.template.json --folder Smoke --reporters cli,junit --reporter-junit-export postman/newman-report.xml",
    "test:postman:local": "start-server-and-test dev http://localhost:3000/v1/health test:postman"
  },
  "dependencies": {
    "@snail-race/shared": "*",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "pino": "^10.3.1",
    "serverless-http": "^4.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.0",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "newman": "^6.2.2",
    "start-server-and-test": "^3.0.12",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.2"
  }
}
