# Ambiente: local | test | develop | staging | production
APP_ENV=local
PORT=3000
# Orígenes permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# true simula la caída completa de SnailPay (503 service_unavailable)
SNAILPAY_OUTAGE=false
# Demora del escenario de timeout (tarjeta 4000000000000408), en ms
SNAILPAY_PROCESSING_DELAY_MS=12000
# Cobros permitidos por minuto y por IP
CHARGES_RATE_LIMIT_PER_MINUTE=20
LOG_LEVEL=info
